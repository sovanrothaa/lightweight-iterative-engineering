#!/usr/bin/env bash
# SessionStart hook for lightweight-iterative-engineering (LIE)
# Injects a short activation bootstrap so LIE is the default workflow
# authority without requiring the user to explicitly select it every time.

set -euo pipefail

bootstrap=$(cat <<'EOF'
<LIE_ACTIVE>
lightweight-iterative-engineering (LIE) is the active workflow authority this session: it
decides how much process a task needs, overriding other installed workflows unless the user
explicitly picks one.

Size non-trivial work fast, not ceremonially: trivial (typo/one-line fix) -> just do it.
Normal (bug fix, small feature) -> light plan, test only if signaled, one light review.
Complex (auth/migration/architecture) -> confirm approach if genuinely uncertain, then
plan/implement/thorough review. Large/parallelizable -> decompose, consider subagents, one
final whole-change review.

Beyond trivial, invoke the 'lightweight-iterative-engineering' skill for full routing,
capability sub-skills, and stop rules.
</LIE_ACTIVE>
EOF
)

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

bootstrap_escaped=$(escape_for_json "$bootstrap")

# Claude Code reads hookSpecificOutput.additionalContext; other harnesses use
# additional_context or a top-level additionalContext. Emit only the field
# the current platform consumes so nothing gets duplicated.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$bootstrap_escaped"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$bootstrap_escaped"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$bootstrap_escaped"
fi

exit 0
